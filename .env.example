# ImaniPay Blockchain Service - Environment Configuration
# Copy this file to .env and update the values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=ImaniPay Blockchain Service
APP_VERSION=2.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================================
# Database Configuration
# ============================================================================
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=imanipay
DB_POSTGRES_PASSWORD=your_password_here
DB_POSTGRES_DB=imanipay_blockchain
DB_POSTGRES_SSL_MODE=prefer

# Connection Pool
DB_DB_POOL_SIZE=10
DB_DB_MAX_OVERFLOW=20
DB_DB_POOL_TIMEOUT=30

# ============================================================================
# Algorand Blockchain Configuration
# ============================================================================

# Network Selection (testnet, mainnet, localnet)
ALGORAND_NETWORK=testnet

# TestNet Configuration
ALGORAND_ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
ALGORAND_INDEXER_TOKEN=

# MainNet Configuration (uncomment for production)
# ALGORAND_ALGOD_ADDRESS=https://mainnet-api.algonode.cloud
# ALGORAND_INDEXER_ADDRESS=https://mainnet-idx.algonode.cloud

# LocalNet Configuration (for AlgoKit development)
ALGORAND_LOCALNET_ALGOD_ADDRESS=http://localhost:4001
ALGORAND_LOCALNET_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ALGORAND_LOCALNET_INDEXER_ADDRESS=http://localhost:8980
ALGORAND_LOCALNET_INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Asset Configuration
ALGORAND_USDC_ASSET_ID=10458941  # TestNet USDC

# Transaction Configuration
ALGORAND_DEFAULT_FEE=1000
ALGORAND_CONFIRMATION_ROUNDS=4

# ============================================================================
# Security Configuration
# ============================================================================

# Encryption (generate a secure 32-character key)
SECURITY_ENCRYPTION_KEY=your-32-character-encryption-key

# Rate Limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_DEFAULT_RATE_LIMIT=1000/minute

# CORS (use specific origins in production)
SECURITY_ALLOWED_ORIGINS=["*"]

# Request Limits
SECURITY_MAX_REQUEST_SIZE=10485760  # 10MB

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log

# ============================================================================
# Development Settings
# ============================================================================

# Set to true to enable detailed error responses
DEV_MODE=true

# Set to true to enable API documentation
ENABLE_DOCS=true

# ============================================================================
# Production Settings (uncomment for production deployment)
# ============================================================================

# APP_ENVIRONMENT=production
# APP_DEBUG=false
# ALGORAND_NETWORK=mainnet
# LOG_LEVEL=WARNING
# SECURITY_ALLOWED_ORIGINS=["https://your-frontend-domain.com"]
# ENABLE_DOCS=false

